#!/usr/bin/env bash
# The Gradle project lives in app/.
cd "$(git rev-parse --show-toplevel)/app" || exit 1
echo "Running detekt check..."
OUTPUT="/tmp/detekt-$(date +%s)"
./gradlew detekt -Pprecommit=true \
	:shared:detekt \
	:shared:detektMainAndroid \
	:androidApp:detektDebug >"$OUTPUT"
EXIT_CODE=$?
if [ $EXIT_CODE -ne 0 ]; then
	cat "$OUTPUT"
	rm "$OUTPUT"
	echo "***********************************************"
	echo "                 detekt failed                 "
	echo " Please fix the above issues before committing "
	echo "***********************************************"
	exit $EXIT_CODE
fi
rm "$OUTPUT"
