# General Project Settings
PROJECT_NAME="Magic Pinecone API"
ENVIRONMENT=dev
API_V1_STR=/api/v1
FRONTEND_HOST=http://localhost:5173

# CORS Settings (comma-separated list of origins)
BACKEND_CORS_ORIGINS="http://localhost:3000,http://localhost:5173,http://localhost:8000"

# PostgreSQL Database Configuration
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=magic_pinecone

# Redis & Celery Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Host ports that docker compose publishes PostgreSQL and Redis on. Change them when
# another project on your machine already uses 5432 or 6379.
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379

# How long a course syllabus fetched from NCU is served before it is fetched again
COURSE_DETAIL_CACHE_HOURS=24

# TDX (https://tdx.transportdata.tw) API key for live bus arrivals.
# While these two are empty, /transit/bus/* answers 503; the rest of the API,
# including /transit/destinations, works without them.
TDX_CLIENT_ID=
TDX_CLIENT_SECRET=
# How long one route's arrivals are reused before TDX is asked again
TDX_ARRIVAL_CACHE_SECONDS=30
# How long a route's stop coordinates are reused
TDX_STOP_CACHE_HOURS=24

# The model behind POST /assistant/ask: any OpenAI-compatible endpoint, the URL
# with its /v1 part (for Ollama: http://localhost:11434/v1). While the first
# two are empty the endpoint returns what it looked up, without a written answer.
ASSISTANT_BASE_URL=
ASSISTANT_MODEL=
ASSISTANT_API_KEY=
# Sent as reasoning_effort; "none" stops a thinking model from thinking first
ASSISTANT_REASONING_EFFORT=
# true sends chat_template_kwargs {"enable_thinking": false}, which is how
# llama-server is told the same. Set it for the tuned Gemma 4 student
# (ml/README.md, "Serve a student"): it was trained without thinking.
ASSISTANT_DISABLE_THINKING=false
# Seconds one request to the model may take
ASSISTANT_TIMEOUT_SECONDS=60
