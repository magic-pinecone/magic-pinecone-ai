# General Project Settings
PROJECT_NAME="Magic Pinecone API"
ENVIRONMENT=dev
API_V1_STR=/api/v1
FRONTEND_HOST=http://localhost:5173

# CORS Settings (comma-separated list of origins)
BACKEND_CORS_ORIGINS="http://localhost:3000,http://localhost:5173,http://localhost:8000"

# PostgreSQL Database Configuration
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=magic_pinecone

# Redis & Celery Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Host ports that docker compose publishes PostgreSQL and Redis on. Change them when
# another project on your machine already uses 5432 or 6379.
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379

# How long a course syllabus fetched from NCU is served before it is fetched again
COURSE_DETAIL_CACHE_HOURS=24

# Optional self-hosted LibreTranslate for guide lines the shipped translations lack; empty turns it off.
# e.g. docker run -p 5000:5000 -e LT_LOAD_ONLY=en,zt,vi libretranslate/libretranslate:v1.9.6
TRANSLATOR_URL=
